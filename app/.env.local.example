# Kopioi tämä tiedosto nimelle .env.local (gitignorattu) ja täytä arvot.
# VITE_LOYTO_API_URL on nyt pakollinen jo pelkkään selailuun: kätköt ja
# löydöt haetaan ajonaikaisesti Workerista (GET /paikat, /loydot, /kuvat/*),
# eikä sovellus näytä yhtään kätköä ilman toimivaa Worker-yhteyttä. Ilman
# VITE_LOYTO_SALASANA-arvoa löydön ilmoittaminen (POST /loyda) epäonnistuu.

VITE_LOYTO_API_URL=https://esimerkki-worker.example.workers.dev
VITE_LOYTO_SALASANA=vaihda-tama-jaettuun-salasanaan
